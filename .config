CONFIG_TARGET_ath79=y
CONFIG_TARGET_ath79_nand=y
CONFIG_TARGET_ath79_nand_DEVICE_netgear_wndr3700v4=y

# High-Availability Core Kernel Modules
CONFIG_NET_HSR=y

# Essential Packages for Network Manipulation
CONFIG_PACKAGE_ip-full=y

# Phone USB Tethering Support
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-ipheth=y
CONFIG_PACKAGE_usbmuxd=y
CONFIG_PACKAGE_libimobiledevice=y
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_usbmode=y

# Multi-WAN & Load Balancing Support
CONFIG_PACKAGE_mwan3=y
CONFIG_PACKAGE_luci-app-mwan3=y

# Recommended Utilities & Diagnostics
CONFIG_PACKAGE_tcpdump-mini=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_irqbalance=y
CONFIG_PACKAGE_luci-app-attendedsysupgrade=y
