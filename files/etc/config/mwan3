config globals 'globals'
	option mmx_mask '0x3F00'

# Track the health of the USB Phone interface
config interface 'wan'
	option enabled '1'
	list track_ip '1.1.1.1'
	list track_ip '8.8.8.8'
	option reliability '1'
	option count '1'
	option timeout '2'
	option interval '5'
	option down '3'
	option up '8'

# Track the health of the Wireless Client interface
config interface 'wwan'
	option enabled '1'
	list track_ip '1.0.0.1'
	list track_ip '8.8.4.4'
	option reliability '1'
	option count '1'
	option timeout '2'
	option interval '5'
	option down '3'
	option up '8'

# Create individual members
config member 'wan_m1'
	option interface 'wan'
	option metric '1'
	option weight '1'

config member 'wwan_m1'
	option interface 'wwan'
	option metric '1'
	option weight '1'

# Create a combined policy with equal weights for true balancing
config policy 'balanced'
	list use_member 'wan_m1'
	list use_member 'wwan_m1'
	option last_resort 'unreachable'

# Apply the balancing policy to all standard internet traffic
config rule 'https'
	option sticky '1'
	option timeout '60'
	option proto 'tcp'
	option dest_port '443'
	option use_policy 'balanced'

config rule 'default_rule'
	option dest_ip '0.0.0.0/0'
	option use_policy 'balanced'
