#!/bin/sh

# 1. CONFIGURE ISOLATED VLAN PORTS INTO THE HSR RING
ip link set eth0.10 down
ip link set eth0.20 down

# Create the HSR interface (hsr0) using the hardware-isolated ports
ip link add name hsr0 type hsr slave1 eth0.10 slave2 eth0.20 interlink none version 0

# Bring the HSR infrastructure up in promiscuous mode for clean bridging
ip link set eth0.10 up
ip link set eth0.20 up
ip link set hsr0 up

# 2. BRIDGE THE HSR RING BACK TO LAN
# This attaches your default 192.168.1.1 network directly to the HSR interface
uci add_list network.device.ports='hsr0'
uci commit network

# 3. START BACKGROUND IPHONE SERVICES
if [ -f /usr/sbin/usbmuxd ]; then
    /usr/sbin/usbmuxd -v --user root &
fi

# 4. CREATE A PERSISTENT HOTPLUG SCRIPT FOR DYNAMIC USB TETHERING
cat << 'EOF' > /etc/hotplug.d/iface/99-usb-tether
#!/bin/sh
INTERFACE="usb0"
if [ "$INTERFACE" = "usb0" ]; then
    if [ "$ACTION" = "ifup" ]; then
        uci set network.wan.device='usb0'
        uci set network.wan.proto='dhcp'
        uci commit network
        /etc/init.d/network restart
    fi
fi
EOF

chmod +x /etc/hotplug.d/iface/99-usb-tether

# 5. FORCE ALL NETWORK LAYERS TO ALIGN
/etc/init.d/network restart

exit 0
