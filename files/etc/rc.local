#!/bin/sh

# 1. INITIALISE THE HSR RING (PORTS 1 & 2)
ip link set eth0.10 down
ip link set eth0.20 down
ip link add name hsr0 type hsr slave1 eth0.10 slave2 eth0.20 interlink none version 0
ip link set eth0.10 up
ip link set eth0.20 up
ip link set hsr0 up

# 2. INITIALISE THE PRP INTERFACE (PORTS 3 & 4)
ip link set eth0.30 down
ip link set eth0.40 down
ip link add name prp0 type prp slave1 eth0.30 slave2 eth0.40 interlink none
ip link set eth0.30 up
ip link set eth0.40 up
ip link set prp0 up

# 3. BRIDGE BOTH HIGH-AVAILABILITY INTERFACES TO THE LAN SUBSTATION
uci add_list network.device.ports='hsr0'
uci add_list network.device.ports='prp0'
uci commit network

# 4. START BACKGROUND IPHONE SERVICES
if [ -f /usr/sbin/usbmuxd ]; then
    /usr/sbin/usbmuxd -v --user root &
fi

# 5. HOTPLUG RULE FOR DYNAMIC USB PHONE TETHERING
cat << 'EOF' > /etc/hotplug.d/iface/99-usb-tether
#!/bin/sh
INTERFACE="usb0"
if [ "$INTERFACE" = "usb0" ]; then
    if [ "$ACTION" = "ifup" ]; then
        uci set network.wan.device='usb0'
        uci set network.wan.proto='dhcp'
        uci commit network
        /etc/init.d/network restart
    fi
fi
EOF

chmod +x /etc/hotplug.d/iface/99-usb-tether

# 6. RELOAD WIRELESS CHIPS AND RESTART NETWORK STACK
wifi reload
/etc/init.d/network restart

exit 0
